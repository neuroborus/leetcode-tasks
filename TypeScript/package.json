{
  "name": "leetcode-tasks",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "author": "neuroborus",
  "scripts": {
    "lint:fix": "eslint . --fix",

    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "start:index": "node ./dist/index.js",
    "start": "npm run clean && npm run build && npm run start:index",

    "easy:add-binary": "npx ts-node -r tsconfig-paths/register src/tasks/easy/add-binary",
    "easy:climbing-stars": "npx ts-node -r tsconfig-paths/register src/tasks/easy/climbing-stars",
    "easy:first-occurrence": "npx ts-node -r tsconfig-paths/register src/tasks/easy/first-occurrence",
    "easy:length-of-last-word": "npx ts-node -r tsconfig-paths/register src/tasks/easy/length-of-last-word",
    "easy:longest-common-prefix": "npx ts-node -r tsconfig-paths/register src/tasks/easy/longest-common-prefix",
    "easy:majority-element": "npx ts-node -r tsconfig-paths/register src/tasks/easy/majority-element",
    "easy:merge-sorted-arrays": "npx ts-node -r tsconfig-paths/register src/tasks/easy/merge-sorted-arrays",
    "easy:merge-two-sorted-lists": "npx ts-node -r tsconfig-paths/register src/tasks/easy/merge-two-sorted-lists",
    "easy:palindrome-number": "npx ts-node -r tsconfig-paths/register src/tasks/easy/palindrome-number",
    "easy:plus-one": "npx ts-node -r tsconfig-paths/register src/tasks/easy/plus-one",
    "easy:remove-dups-from-sorted-array": "npx ts-node -r tsconfig-paths/register src/tasks/easy/remove-dups-from-sorted-array",
    "easy:remove-element": "npx ts-node -r tsconfig-paths/register src/tasks/easy/remove-element",
    "easy:search-insert-position": "npx ts-node -r tsconfig-paths/register src/tasks/easy/search-insert-position",
    "easy:sqrt": "npx ts-node -r tsconfig-paths/register src/tasks/easy/sqrt",
    "easy:two-sums": "npx ts-node -r tsconfig-paths/register src/tasks/easy/two-sums",
    "easy:valid-parenteses": "npx ts-node -r tsconfig-paths/register src/tasks/easy/valid-parenteses",
    "easy:roman": "npx ts-node -r tsconfig-paths/register src/tasks/easy/roman-to-integer",

    "medium:binary-tree-level-observer-travesal": "npx ts-node -r tsconfig-paths/register src/tasks/medium/binary-tree-level-observer-travesal",
    "medium:combination-sum": "npx ts-node -r tsconfig-paths/register src/tasks/medium/combination-sum",
    "medium:kth-largest-element-in-an-array": "npx ts-node -r tsconfig-paths/register src/tasks/medium/kth-largest-element-in-an-array",
    "medium:longest-substring-without-repeating-characters": "npx ts-node -r tsconfig-paths/register src/tasks/medium/longest-substring-without-repeating-characters",
    "medium:longest-palindromic-substring": "npx ts-node -r tsconfig-paths/register src/tasks/medium/longest-palindromic-substring",
    "medium:maximum-sum-of-distinct-subarrays-with-length-k": "npx ts-node -r tsconfig-paths/register src/tasks/medium/maximum-sum-of-distinct-subarrays-with-length-k",
    "medium:remove-dups-from-sorted-array-2": "npx ts-node -r tsconfig-paths/register src/tasks/medium/remove-dups-from-sorted-array-2",
    "medium:rotate-array": "npx ts-node -r tsconfig-paths/register src/tasks/medium/rotate-array",
    "medium:validate-binary-search-tree": "npx ts-node -r tsconfig-paths/register src/tasks/medium/validate-binary-search-tree",
    "medium:top-k-frequent-elements": "npx ts-node -r tsconfig-paths/register src/tasks/medium/top-k-frequent-elements",


    "alghorithms:quicksort": "npx ts-node -r tsconfig-paths/register src/algorithms/quicksort.ts",
    "alghorithms:mergesort": "npx ts-node -r tsconfig-paths/register src/algorithms/mergesort.ts",
    "alghorithms:dijkstra": "npx ts-node -r tsconfig-paths/register src/algorithms/dijkstra.ts",

    "examples:buganizer-cycles": "npx ts-node -r tsconfig-paths/register src/examples/buganizer-cycles.ts",

    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@types/module-alias": "^2.0.4",
    "@types/node": "^22.10.4",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint": "^8.0.1",
    "prettier": "^2.3.2",
    "rimraf": "^5.0.5",
    "module-alias": "^2.2.3",
    "tsconfig-paths": "^4.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
